function postMessageToParent(data) {
    window.parent.postMessage(data, parentDomain);
}

// GETTING THRIVE DIGEST FROM ZOHO COMMERCE
async function identifyZohoCommerce(dataOfZohoCommerce) {
    if (dataOfZohoCommerce !== undefined && dataOfZohoCommerce.current_user !== undefined &&
        dataOfZohoCommerce.current_user.emailid !== undefined && dataOfZohoCommerce.current_user.emailid != '') {
        customerData = {};
        customerData.email = dataOfZohoCommerce.current_user.emailid;
        customerData.zt_customer_id = dataOfZohoCommerce.current_user.contact_id;
        var userDetailAuth = (await thrivePublicServer.createThriveDigest(thriveWidgetCode, customerData)).data;
        if (userDetailAuth !== undefined && userDetailAuth.generatehmac !== undefined) {
            customerData.thrive_digest = userDetailAuth.generatehmac;
        }
    } else {
        commerceSignupUrl = dataOfZohoCommerce.signUpPage;
        commerceSignInUrl = dataOfZohoCommerce.signInPage;
        commerceLoginRequired = true;
    }
    getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, customerData)).data;
    if (getData && ('program_mapped_user' in getData) && getData.program_mapped_user) {
        deleteRefCookieInLocalStorage(thriveWidgetCode);
        postMessageToParent('deleteParentThriveCookie'); // NO I18N
    }
    initiatePage();
    // thrivePublicServer.identifyMember(thriveWidgetCode, JSON.stringify(customerData));
}

async function identifyTrainerCentral(dataOfTC) {
    if (dataOfTC !== undefined && dataOfTC.isSignedIn && dataOfTC.userInfo !== undefined &&
        dataOfTC.userInfo.userEmail !== undefined && dataOfTC.userInfo.userEmail != '') {
        customerData = {};
        customerData.email = dataOfTC.userInfo.userEmail;
        customerData.zt_customer_id = dataOfTC.userInfo.userId;
        var userDetailAuth = (await thrivePublicServer.createThriveDigest(thriveWidgetCode, customerData)).data;
        if (userDetailAuth !== undefined && userDetailAuth.generatehmac !== undefined) {
            customerData.thrive_digest = userDetailAuth.generatehmac;
        }
    } else {
        commerceSignupUrl = dataOfTC.signUpPage;
        commerceSignInUrl = dataOfTC.signInPage;
        commerceLoginRequired = true;
    }
    getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, customerData)).data;
    if (getData && ('program_mapped_user' in getData) && getData.program_mapped_user) {
        deleteRefCookieInLocalStorage(thriveWidgetCode);
        postMessageToParent('deleteParentThriveCookie'); // NO I18N
    }
    initiatePage();
    // thrivePublicServer.identifyMember(thriveWidgetCode, JSON.stringify(customerData));
}

async function identifyWixCommerce(dataOfZohoCommerce) {
    if (dataOfZohoCommerce !== undefined && dataOfZohoCommerce.member !== undefined &&
        dataOfZohoCommerce.member.id !== undefined && dataOfZohoCommerce.signedToken !== undefined) {
        customerData = {};
        customerData.zt_customer_id = dataOfZohoCommerce.signedToken;
    } else {
        commerceSignupUrl = dataOfZohoCommerce.signUpPage;
        commerceSignInUrl = dataOfZohoCommerce.signInPage;
        commerceLoginRequired = true;
    }
    getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, customerData)).data;
    if (getData && ('program_mapped_user' in getData) && getData.program_mapped_user) {
        deleteRefCookieInLocalStorage(thriveWidgetCode);
        postMessageToParent('deleteParentThriveCookie'); // NO I18N
    }
    initiatePage();
    // thrivePublicServer.identifyMember(thriveWidgetCode, JSON.stringify(customerData));
}

async function identifyCustomUserSite(dataOfCustomSite) {
    if (dataOfCustomSite !== undefined && dataOfCustomSite.za_email_id !== undefined &&
        dataOfCustomSite.user_unique_id !== undefined && dataOfCustomSite.za_email_id != '' && dataOfCustomSite.user_unique_id != '') {

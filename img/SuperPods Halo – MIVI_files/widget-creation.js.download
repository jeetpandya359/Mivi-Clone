function loadTaskAndReward() {
    if (updatePoints) {
        byId('bannerPoints').innerHTML = getData.points_details.earned_points; //no I18N
    }
    var trWrapper = document.getElementsByClassName('tr-wrapper')[0];
    trWrapper.innerHTML = '';
    trWrapper.append(closeButtonCreate());
    var trGroup = ['criteria', 'reward']; // no I18N
    // BOTTOM DIV
    for (var tr = 0; tr < trGroup.length; tr++) {
        var trItem = trGroup[tr];
        var containerGroup = trItem === 'criteria' ? 'points' : trItem; // no I18N
        var keys = Object.keys(getData['loyalty_' + trItem]); // no I18N
        var opposite = trItem === 'criteria' ? 'reward' : 'criteria'; // no I18N
        var popHeader = createEle('div', 'pop-header'); // no I18N
        var viewHeader = createEle('h3'); // no I18N
        viewHeader.innerHTML = headerTitles[trItem];
        popHeader.append(viewHeader);
        var listingUl = createEle('ul'); // no I18N
        var trContainer = createEle('div', 'tr-container'); // no I18N
        trContainer.setAttribute('tr-group', containerGroup); // no I18N
        trContainer.append(popHeader, listingUl);
        document.getElementsByClassName('tr-wrapper')[0].append(trContainer); // no I18N
        for (var task = 0; task < keys.length; task++) {
            if (getData.members_criteria_reward_json[keys[task]].status !== 'not_applicable') {
                var follow_url;
                var taskItem = getData['loyalty_' + trItem][keys[task]];
                var taskName = Object.keys(getData['loyalty_' + trItem][keys[task]]['user_' + trItem + 's_detail'][trItem + 's'])[0];
                var taskId = keys[task];
                if (checkIfFollowMedium(taskName)) {
                    var urlKey = taskName === 'refer_a_survey' ? 'unique_url' : 'pageurl' // no I18N
                    follow_url = getData['loyalty_' + trItem][keys[task]]['user_' + trItem + 's_detail'][trItem + 's'][taskName][urlKey];
                }
                var points = taskItem['user_' + opposite + 's_detail'][opposite + 's'].points.count // no I18N
                var taskTypeLabel = 'loyalty_' + trItem; // NO I18N
                var loyaltyRewardName = '';
                var rewardJSON = (getData['loyalty_' + trItem][keys[task]]['user_' + trItem + 's_detail'][trItem + 's'])[taskName];
                var loyaltyCouponName = '';
                if (taskTypeLabel.toLowerCase() == 'loyalty_reward' && rewardJSON != null && taskName != null && rewardJSON.hasOwnProperty('name')) {
                    loyaltyCouponName = rewardJSON.name;
                }
                var taskLabelToShow;
                if (taskTypeLabel.toLowerCase() == 'loyalty_reward' && loyaltyCouponName) {
                    taskLabelToShow = loyaltyCouponName;
                }
                // else if (taskName === 'custom_activity_tracker') {
                //     taskLabelToShow = getData['loyalty_' + trItem][keys[task]].criteria_config_name;
                // }
                else {
                    taskLabelToShow = getData['loyalty_' + trItem][keys[task]].criteria_config_name;
                }

                var li = createEle('li', 'tr-list-item'); // no I18N
                li.setAttribute('tr-item', taskName); // no I18N
                li.setAttribute('tr-group', trItem); // no I18N
                li.setAttribute('tr-group', trItem); // no I18N
                var taskDiv = createEle('div', 'tr-name'); // no I18N
                var pointsDiv = '<span>' + ((taskName === 'friend_purchase' || taskName === 'member_purchase') ? getData.store_currency.symbol +'1' +  ' = ' : '') + points + ' points</span>'
                taskDiv.innerHTML = taskLabelToShow + pointsDiv;
                if(taskName === 'member_purchase' || taskName === 'purchase_value_goal' || taskName === 'purchase_count_goal'){
                    var minCount = ((getData['loyalty_' + trItem][keys[task]]['user_' + trItem + 's_detail'][trItem + 's'])[taskName]).count
                    var minvalueDiv = createEle('div', 'tr-min-value-txt'); //no I18N
                    minvalueDiv.innerHTML = '<span class="prod-coupon")">'+purchaseTaskDescription(taskName)+ '> '+((taskName === 'member_purchase' || taskName === 'purchase_value_goal')? getData.store_currency.symbol : '')+minCount+(taskName ==='purchase_count_goal' ? ' orders': '') //no I18N
                    taskDiv.append(minvalueDiv)+'</span>'
        
                }
                if (getData.members_criteria_reward_json[keys[task]].status !== 'completed' && taskItem.end_date != -1 && returnDays(taskItem.end_date) <= 7) {
                    var endDate = createEle('div', 'tr-expiring-txt'); // no I18N
                    endDate.innerHTML = 'Will expire in ' + returnDays(taskItem.end_date) + ' days'; // no I18N
                    taskDiv.append(endDate);
                }
                if (platformType == 'zoho_commerce') {
                    if (taskName == 'product_unique_coupon') {
                        var couponId = getData['loyalty_' + trItem][keys[task]]['user_' + trItem + 's_detail'][trItem + 's'][taskName].commerce_product_unique_id;
                        var courponUrl = getData.purchase_url.replace('http', 'https') + '/products/' + couponId; // no I18N
                        taskDiv.innerHTML = taskDiv.innerHTML + '<span class="prod-coupon" onClick="couponPopup(\'' + courponUrl + '\')">View Product</span>';
                    } else if (taskName == 'collection_unique_coupon') { // no I18N
                        var couponId = getData['loyalty_' + trItem][keys[task]]['user_' + trItem + 's_detail'][trItem + 's'][taskName].commerce_collection_unique_id;
                        var courponUrl = getData.purchase_url.replace('http', 'https') + '/collections/' + couponId; // no I18N
                        taskDiv.innerHTML = taskDiv.innerHTML + '<span class="prod-coupon" onClick="couponPopup(\'' + courponUrl + '\')">View Collection</span>';
                    }
                }
                li.append(taskDiv);
                if (getData.signed_up_user) {
                    if (trItem === 'criteria' && getData.members_criteria_reward_json[keys[task]].status === 'completed') {
                        var completedIcon = createEle('div', 'task-completed-icon'); // no I18N
                        li.append(completedIcon);
                    } else if (taskName !== 'custom_activity_tracker') {
                        var actionBtn = createEle('div', 'btn-style'); // no I18N
                        if (trItem === 'criteria') {
                            actionBtn.innerHTML = btnLabels[taskName];
                            actionBtn.addEventListener('click', initiateTask.bind(null, taskName, taskId, follow_url, taskLabelToShow, ''));
                        } else {
                            actionBtn.innerHTML = 'Redeem'; // no I18N
                            if (points <= getData.points_details.earned_points) {
                                actionBtn.addEventListener('click', redeemPoints.bind(null, taskId, '')); // no I18N
                            } else {
                                actionBtn.classList.add('not-enough-points'); // no I18N
                            }
                        }
                        actionBtn.style.background = getData.page_preference_details.theme_color;
                        var actionBtnFrame = createEle('div', 'tr-actions'); // no I18N
                        actionBtnFrame.append(actionBtn);
                        li.append(actionBtnFrame);
                    }
                }
                document.querySelector('.tr-wrapper [tr-group="' + containerGroup + '"] ul').append(li); // no I18N
            }
        }
    }
    updatePointsText()
}

function returnDays(date) {
    var date1 = new Date();
    var date2 = new Date(parseInt(date));
    // Calculate the difference in milliseconds between the two dates
    var diffInMs = Math.abs(date2 - date1);
    // Convert milliseconds to days
    var days = Math.ceil(diffInMs / (1000 * 60 * 60 * 24));
    return days;
}

function updatePointsText() {
    var points = document.querySelectorAll(".points-txt"); // no I18N
    points.forEach((point) => {
        point.innerHTML = getData.points_details.earned_points;
    });
}

function purchaseTaskDescription(taskName){
    if(taskName === 'member_purchase'){  // NO I18N
        return "Purchase value ";  // NO I18N
    }else if(taskName === 'purchase_value_goal'){  // NO I18N
        return "Total purchase value ";  // NO I18N
    }else if(taskName === 'purchase_count_goal'){  // NO I18N
        return "Total purchase count ";  // NO I18N
    }

}

async function initiateTask(taskName, criteriaId, follow_url, taskLabelToShow) {
    if (taskName === 'refer_a_friend' || taskName === 'friend_purchase') {
        referOnSocialMedia();
    } else if (taskName === "share_facebook") {
        var postData = await loyaltyServer.getSocialTask(thriveWidgetCode, criteriaId, 'facebook'); // no I18N
        openNewWindow('https://www.facebook.com/sharer/sharer.php?u=' + postData.user_share_url + '&quote=' + postData.social_medium_message); // NO I18N
        whileRedirect(taskName, taskLabelToShow)
    } else if (taskName === "share_twitter") { // NO I18N
        var postData = await loyaltyServer.getSocialTask(thriveWidgetCode, criteriaId, 'twitter'); // no I18N
        openNewWindow('https://twitter.com/intent/tweet?text=' + postData.social_medium_message); // NO I18N
        whileRedirect(taskName , taskLabelToShow)
    } else if (taskName === "member_purchase" || taskName === 'purchase_value_goal' || taskName === 'purchase_count_goal') {
        if (getData.purchase_url && getData.purchase_url !== null) {
            openNewWindow(getData.purchase_url);
        }
    } else if (taskName === "refer_a_survey") {
        whileRedirect(taskName, taskLabelToShow);
        openNewWindow(follow_url);
    } else if (checkIfFollowMedium(taskName)) {
        handleSocialMediaFollow(taskName, criteriaId, follow_url);
    }
}

async function handleSocialMediaFollow(taskName, criteriaId, follow_url) {
    var postData = await loyaltyServer.getSocialFollowTask(thriveWidgetCode, criteriaId, taskName);
    var postUrl;
    if (taskName === "like_facebook") {
        postUrl = 'https://www.facebook.com/plugins/page.php?href=facebook.com%2F' + follow_url; // NO I18N
    } else if (taskName === "follow_twitter") {
        postUrl = 'https://twitter.com/intent/follow?screen_name=' + follow_url; // NO I18N
    } else if (taskName === "follow_linkedin") {
        postUrl = 'https://linkedin.com/company/' + follow_url; // NO I18N
    } else if (taskName === "follow_instagram") {
        postUrl = 'https://instagram.com/' + follow_url; // NO I18N
    } else if (taskName === "youtube_subscribe") {
        postUrl = 'https://youtube.com/' + follow_url + '?sub_confirmation=1'; // NO I18N
    }
    openNewWindow(postUrl);
    postingSuccess(postData, taskName, criteriaId, thriveWidgetCode);
}

function referOnSocialMedia() {
    var popupContent = createEle('div'); // no I18N
    var heading = createEle('h2', ''); // no I18N
    heading.setAttribute('class', 'popup-head');
    heading.innerHTML = 'Share link'; // NO I18N
    var iconsContainer = createEle('div', 'social-icons-container'); // no I18N
    var iconsList = ['facebook', 'linkedin', 'twitter', 'whatsapp', 'copy']; // no I18N
    for (var icon = 0; icon < iconsList.length; icon++) {
        var eachIcon = createEle('span', 'social-icon'); // no I18N
        eachIcon.addEventListener('click', simpleSocialShare.bind(null, iconsList[icon], ''));
        eachIcon.setAttribute('medium-type', iconsList[icon]);
        iconsContainer.append(eachIcon);
    }
    var copiedText = createEle('div', 'copied-txt'); // no I18N
    copiedText.innerHTML = 'Copied!'; // no I18N
    iconsContainer.append(copiedText);
    popupContent.append(heading, iconsContainer);
    createModalOverlay(popupContent);
}

function whileRedirect(taskKey, taskLableToShow) {
    var popupContent = createEle('div'); // no I18N
    var popupHead = createEle('h2', 'popup-head'); // no I18N
    popupHead.innerHTML = taskLableToShow; 
    var content = createEle('p', 'mB0'); // no I18N
    if(taskKey==='refer_a_survey'){
        content.innerHTML = 'You will be awarded for some points immediately after you submit the survey'; // no I18N
    }else{
        content.innerHTML = 'You will be awarded with the points immediately after a friend visits the URL you shared';  // no I18N
    }
    popupContent.append(popupHead, content);
    createModalOverlay(popupContent);
}

function createModalOverlay(popupContent) {
    var overlay = createEle('div', 'pop-overlay active'); // no I18N
    var container = createEle('div', 'pop-container'); // no I18N
    var closeIcon = '<span class="close-icon" onClick="closeInnerPop()"></span>'; // no I18N
    container.innerHTML = closeIcon;
    container.append(popupContent)
    overlay.append(container);
    document.body.append(overlay);
}

var redeemID;
async function redeemPoints(id) {
    redeemID = id;
    var popupContent = createEle('div'); // no I18N
    var heading = createEle('h2', 'popup-head'); // no I18N
    heading.innerHTML = 'Want to redeem?'; // NO I18N
    var description = createEle('p', 'redeem-desc'); // no I18N
    description.innerHTML = 'Do you want to redeem this reward. If yes, please click the button below.'; // NO I18N
    var closeButton = document.createElement('div');
    closeButton.setAttribute('class', 'btn-style lp-primary-btn redeem-confirm');
    closeButton.style.background = getData.page_preference_details.theme_color;
    closeButton.innerHTML = 'Yes, Redeem'; // no I18N
    closeButton.addEventListener('click', redeemConfirmationPop);
    popupContent.append(heading, description, closeButton);

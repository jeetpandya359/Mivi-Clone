async function joinCampaign() {
    var loadBtn = userConsent ? 'accept-cookies-btn' : 'join-campaign-btn'; // no I18N 
    byId(loadBtn).classList.add('btn-loading'); // no I18N
    var optinResponse = await thrivePublicServer.campoptin(thriveWidgetCode, customerData);
    byId(loadBtn).classList.remove('btn-loading'); // no I18N
    if (optinResponse.status === 200) {
        if (optinResponse.data.error_code === 100270) {
            byId('joinSection').innerHTML = '<p class="sp-desc">Looks like an email with similar alias is part of this program. Kindly try logging in using that store.</p>';
        } else {
            document.body.innerHTML = '';
            document.body.classList.add('widget-loading'); // no I18N
            getContent();
        }
    }
}

async function userLogin() {
    var email = byId('login_email_id'); // NO I18N
    removeFieldError();
    if (!emailVerify(email.value)) {
        email.classList.add('error'); // no I18N
        email.focus();
        addFieldError(email, 'Enter a proper email address'); // NO I18N
    } else {
        byId('login-submit-btn').classList.add('btn-loading'); // no I18N
        var sendData = {
            "za_email_id": email.value.trim() // no I18N
        };
        var loginStatus = await httpRequest('POST', 'publicapi/' + thriveWidgetCode + '/login', JSON.stringify(sendData)); // NO I18N
        byId('login-submit-btn').classList.remove('btn-loading'); // no I18N
        if (loginStatus.status === 404) {
            email.classList.add('error'); // NO I18N
            email.focus();
            addFieldError(email, 'Email id does not exist'); // NO I18N

        } else if (loginStatus && loginStatus.data.code > 199 && loginStatus.data.code < 300) {
            document.getElementsByClassName('display-login')[0].style.display = 'none';
            document.getElementsByClassName('success-frame')[0].classList.add('show'); // NO I18N
        }
    }
}


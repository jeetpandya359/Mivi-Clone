        customerData.zt_customer_id = dataOfCustomSite.user_unique_id;
        customerData.thrive_digest = dataOfCustomSite.thrive_digest;
    } else {
        commerceSignupUrl = dataOfCustomSite.signUpPage;
        commerceSignInUrl = dataOfCustomSite.signInPage;
        commerceLoginRequired = true;
    }
    getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, customerData)).data;
    if (getData && ('program_mapped_user' in getData) && getData.program_mapped_user) {
        deleteRefCookieInLocalStorage(thriveWidgetCode);
        postMessageToParent('deleteParentThriveCookie'); // NO I18N
    }
    initiatePage();
    // thrivePublicServer.identifyMember(thriveWidgetCode, JSON.stringify(customerData));
}

async function checkLoginProcessingRequired() {
    var loginHash = getUrlParameter('loginhash'); // NO I18N
    if (loginHash !== undefined && loginHash !== null && loginHash !== '') {
        var loginCheck = 'publicapi/' + thriveWidgetCode + '/login/' + loginHash; // NO I18N
        await httpRequest('GET', loginCheck); // NO I18N
    }
    return;
}

function isProgramActive(statusToCheck) {
    return statusToCheck === 'active' ? true : false; // NO I18N
}

function initiatePage() {
    var widgetBlockStatus = false;
    if (getData) {
        var memberBlockStatus = getData.is_member_blocked;
        if (memberBlockStatus || !(isProgramActive(getData.loyalty_status) || isProgramActive(getData.review_status)) || (getData.error_code && (getData.error_code === 100020 || getData.error_code === 100060))) {
            widgetBlockStatus = true;
        }
    }
    getData.page_preference_details.widgetBlockingStatus = widgetBlockStatus;
    var themeData = getData.page_preference_details;
    if (themeData && themeData.theme_color) {
        document.documentElement.style.setProperty('--themeColor', themeData.theme_color); // NO I18N
    }
    themeData.messageFrom = 'Thrive'; // NO I18N
    postMessageToParent(themeData);
    if (getData !== undefined && getData.error_code !== undefined && getData.error_code === 100040) {
        document.body.innerHTML = '<p class="program-inactive-frame">Program is not active!</p>';
    } else {
        signedup = getData.signed_up_user;
        shareurl = getData.user_share_url ? getData.user_share_url : '';
        if (updateReviews) {
            reviewsListing(getData);
            updateReviews = false;
            byId('bannerPoints').innerHTML = getData.points_details.earned_points; // NO I18N
        } else if (updatePoints) {
            loadTaskAndReward();
            updatePoints = false;
        } else if (!hideThriveWidget) {
            createHTML();
        }
    }
}

function closeButtonCreate(closeItem) {
    var modalClose = createEle('div', 'modal-close'); // no I18N
    document.getElementsByClassName('tr-wrapper')[0].innerHTML = ''; // no I18N
    modalClose.addEventListener('click', closeModal.bind(null, closeItem, '')); // no I18N
    return modalClose;
}

var programsDetails = {
    loyalty_status: {
        key: 'points', // no I18N
        title: 'Points', // no I18N
        tabs: ['Ways to Earn'], // no I18N
        description: ''
    },
    review_status: {
        key: 'review', // no I18N
        title: 'Reviews', // no I18N
        tabs: ['Ways to Share'], // no I18N
        description: ''
    },
    multitask_status: {
        key: 'activity', // no I18N
        title: 'Activity', // no I18N
        tabs: ['Ways to earn'], // no I18N
        description: ''
    },
    vip_loyalty_status: {
        key: 'vip', // no I18N
        title: 'VIP', // no I18N
        tabs: [],
        description: 'Your all access pass to exclusive rewards. Reach higher tiers for more exclusive perks' // no I18N
    }
}

async function createHTML() {
    /*if (!updatePoints) {*/
    var content = getData;
    var container = createEle('div', 'widget-container', 'widgetContainer'); // no I18N
    container.style = 'font-family: ' + content.page_preference_details.font_family; // no I18N
    var firstPage = createEle('div', 'widget-first-page'); // no I18N
    // BANNER SECTION
    var banner = createEle('div', 'widget-banner'); // no I18N
    banner.style.background = content.page_preference_details.theme_color;
    var bannerTxt = createEle('div', 'banner-txt'); // no I18N
    var bannerSpan = createEle('span'); // no I18N
    bannerSpan.id = "bannerPoints";
    bannerSpan.innerHTML = content.signed_up_user ? getData.points_details.earned_points : content.page_preference_details.program_name;
    bannerTxt.innerHTML = content.signed_up_user ? 'Available points' : 'Welcome to'; // no I18N
    bannerTxt.append(bannerSpan);
    banner.append(bannerTxt);
    if (getData.signed_up_user) {
        var redeemBtn = createEle('div', 'redeem-btn'); // no I18N
        redeemBtn.innerHTML = 'Redeem'; // no I18N
        redeemBtn.addEventListener('click', openSection.bind(null, 'reward', ''))
        banner.append(redeemBtn);
    }
    firstPage.append(banner);

    // CONTENT SECTION
    var sectionsDiv = createEle('div', 'widget-content-section'); // no I18N
    if (commerceLoginRequired || (!commerceLoginRequired && (content.opt_in_required !== undefined && content.opt_in_required))) {
        // JOIN SECTION
        var joinSection = createEle('div', 'widget-section'); // no I18N
        joinSection.id = 'joinSection';
        var joinTitle = createEle('h2'); // no I18N
        joinTitle.innerHTML = content.page_preference_details.page_heading;
        var joinDescription = createEle('p'); // no I18N
        joinDescription.innerHTML = content.page_preference_details.page_description;
        var joinButton = createEle('div', 'btn-style'); // no I18N
        joinButton.style.background = content.page_preference_details.theme_color;
        joinButton.setAttribute('id', 'join-campaign-btn');
        if (commerceLoginRequired) {
            joinButton.innerHTML = 'Signup'; // no I18N
            joinButton.addEventListener('click', redirectToCommerceSignup);
        } else {
            joinButton.innerHTML = content.page_preference_details.button_text;
            if (userConsent === true) {
                joinButton.addEventListener('click', confirmCookieBeforeOptin);
            } else {
                joinButton.addEventListener('click', joinCampaign);
            }
        }

        var alreadyHaveAccount = createEle('div', 'mT10'); // no I18N
        if (commerceLoginRequired) {
            var signSpanButton = createEle('span', 'anchor-text'); // no I18N
            signSpanButton.innerHTML = 'Sign in'; // no I18N
            signSpanButton.addEventListener('click', redirectToCommerceSignIn);
            alreadyHaveAccount.innerHTML = 'Already have an account? '; // no I18N
            alreadyHaveAccount.append(signSpanButton);
        }
        joinSection.append(joinTitle, joinDescription, joinButton, alreadyHaveAccount);
        // PRIVACY POLICY
        if (content.page_preference_details.privacy_policy_link) {
            var privacyDiv = createEle('div'); // no I18N
            privacyDiv.append(privacyElement);
            joinSection.append(privacyDiv);
        }
        sectionsDiv.append(joinSection)
    }

    var programKeys = Object.keys(programsDetails);
    for (var program = 0; program < programKeys.length; program++) {
        var activeProgram = programKeys[program];
        if (getData[activeProgram] === 'active' && tasksNotEmpty(activeProgram)) {
            programsDetails[activeProgram].description = programsDetails[activeProgram].description ? programsDetails[activeProgram].description : getData.page_preference_details[programsDetails[activeProgram].key + '_description']
            programsDetails[activeProgram].tabs = activeProgram === 'vip_loyalty_status' ? getData.vip_program_details.tier_levels_data : programsDetails[activeProgram].tabs; // no I18N
            var programBox = createWhiteBox(programsDetails[activeProgram]);
            sectionsDiv.append(programBox);
        }
    }

    if (content.signed_up_user) {
        // YOUR REWARDS
        var yourRewards = createEle('div', 'widget-section'); // no I18N
        yourRewards.id = 'yourRewards'; // no I18N
        yourRewards.addEventListener('click', openTransactionsList);
        var rewardsActivity = createEle('div', 'rewards-activity'); // no I18N
        rewardsActivity.innerHTML = 'Points activity history'; // no I18N
        yourRewards.append(rewardsActivity);
        sectionsDiv.append(yourRewards);

        // TRANSACTION LISTING
        var transactionsWrapper = createEle('div', 'transactions-view-section pop-frame'); // no I18N
        var transactionsContainer = createEle('div', 'transactions-wrapper pop-wrapper'); // no I18N
        transactionsWrapper.append(transactionsContainer);
        //transactionsListing();
        var optOutSection = createEle('div', 'widget-section'); // no I18N
        optOutSection.id = 'optOutBox'; // no I18N
        optOutSection.addEventListener('click', optOutConfirmation);
        var optOut = createEle('div', 'optout-box'); // no I18N
        optOut.innerHTML = 'Opt-out from this program'; // no I18N
        optOutSection.append(optOut);
        sectionsDiv.append(optOutSection);
    }

    // TASK VIEW SECTION
    var viewSection = createEle('div', 'tr-view-section pop-frame'); // no I18N
    var viewWrapper = createEle('div', 'tr-wrapper pop-wrapper'); // no I18N
    viewSection.append(viewWrapper);

    firstPage.append(sectionsDiv);
    container.append(firstPage, viewSection, transactionsWrapper ? transactionsWrapper : '');

    // POWERED BY THRIVE
    if (getData.whitelabel_details !== undefined && getData.whitelabel_details.powered_by_display !== undefined &&
        getData.whitelabel_details.powered_by_display === 'show') { // no I18N
        var poweredBox = createEle('div', 'powered-box'); // no I18N
        poweredBox.innerHTML = 'Powered by <i></i> Thrive'; // no I18N
        document.body.append(container, poweredBox);
        byId('widgetContainer').classList.add('powered-by-added'); // no I18N  
    } else {
        document.body.append(container);
    }
    setTimeout(function() {
        document.body.classList.remove('widget-loading');  // no I18N  
    }, 100);
}

function tasksNotEmpty(program) {
    var status = true;
    if (program === 'review_status' && getData.review_criterias && !Object.keys(getData.review_criterias).length) {
        status = false;
    }
    return status;
}

function optOutConfirmation() {
    var popupContent = createEle('div'); // no I18N
    var heading = createEle('h2', 'popup-head'); // no I18N
    heading.innerHTML = 'Opt-out from this program'; // no I18N
    var description = createEle('div'); // no I18N
    description.innerHTML = "You'll no longer be considered a part of this program, and all your actions prior to this will be put on hold until you opt back in. <br><br> <span class='note-txt'><strong>Note:</strong> While you are gone, your activity records will be maintained securely. You can send us a request email if you want it removed permanently.</span>"; // no I18N
    var closeButton = createEle('div'); // no I18N
    closeButton.setAttribute('class', 'btn-style red-btn mT20');
    closeButton.setAttribute('id', 'opt-out-btn');
    closeButton.innerHTML = 'Opt-out'; // no I18N
    closeButton.addEventListener('click', optOutConfirm);
    popupContent.append(heading, description, closeButton);
    createModalOverlay(popupContent);
}

async function optOutConfirm() {
    byId('opt-out-btn').classList.add('btn-loading'); // no I18N
    var optResp = await httpRequest('POST', 'widget/' + thriveWidgetCode + '/campoptout', ); // no I18N
    byId('opt-out-btn').classList.remove('btn-loading'); // no I18N
    if (optResp.status === 200) {
        document.body.innerHTML = '';
        showAnnouncement('Opted-out successfully!', 'success'); // no I18N
        getData = null;
        getContent();
    }
}

function privacyHTML(link) {
    privacyElement = createEle('div', 'anchor-text'); // no I18N
    privacyElement.innerHTML = 'Privacy policy'; // no I18N
    privacyElement.addEventListener('click', openNewWindow.bind(null, link, ''));
    // privacyElement.setAttribute('href', link); // no I18N
    // privacyElement.setAttribute('target', '_blank'); // no I18N
}

function openTransactionsList() {
    transactionsListing()
    document.getElementsByClassName('transactions-view-section')[0].classList.add('active'); // no I18N
}

async function transactionsListing() {
    dataLoading = true;
    loadMore = true;
    var APIUrl = loadMoreCount > 0 ? 'widget/' + thriveWidgetCode + '/fetchtransactions/' + loadMoreCount : 'widget/' + thriveWidgetCode + '/fetchtransactions'; // no I18N
    var getTransactionsData = await httpRequest('GET', APIUrl); // no I18N
    if (getTransactionsData.data.transactions.length < 10) {
        loadMore = false
    }
    dataLoading = false;
    var transactionsData = getTransactionsData.data.transactions;
    var listingUl = createEle('ul', 'transaction-listing'); // no I18N
    if (loadMoreCount <= 0) {
        var popHeader = createEle('div', 'pop-header'); // no I18N
        var header = createEle('h3'); // no I18N
        header.innerHTML = 'Points activity history'; // no I18N
        popHeader.append(header);
        var containerDiv = createEle('div', 'transaction-container'); // no I18N
        containerDiv.append(popHeader, listingUl);
        document.getElementsByClassName('transactions-wrapper')[0].append(closeButtonCreate('transaction'), containerDiv); // no I18N
        document.getElementsByClassName('transactions-wrapper')[0].addEventListener('scroll', loadMoreTransaction); // no I18N
    }
    createTransactionItems(transactionsData);
}

function createTransactionItems(data) {
    for (var list = 0; list < data.length; list++) {
        var listLi = createEle('li'); // no I18N
        var listReason = createEle('div', 'earned-reason'); // no I18N
        listReason.innerHTML = data[list].description;
        var earnedDate = createEle('span', 'earned-date'); // no I18N
        earnedDate.innerHTML = returnDate(data[list].transaction_date);
        listReason.append(earnedDate);
        var listPoints = createEle('div', 'earned-points'); // no I18N
        var points = data[list].earned_points > 0 ? '+' + data[list].earned_points : (listPoints.classList.add('redeemed'), data[list].earned_points);
        listPoints.innerHTML = points;
        listLi.append(listReason, listPoints);
        document.getElementsByClassName('transaction-listing')[0].append(listLi);
    }
}

function loadMoreTransaction() {
    var wrapper = document.getElementsByClassName('transactions-wrapper')[0];
    var containerHeight = document.getElementsByClassName('transaction-container')[0].clientHeight;
    var scrolltop = wrapper.scrollTop;
    var wrapperHeight = wrapper.clientHeight;
    if (scrolltop >= (containerHeight - wrapperHeight)) {
        loadMoreData();
    }
}

var loadMoreCount = 0,
    dataLoading = false,
    loadMore = false;

function loadMoreData() {
    if (loadMore && !dataLoading) {
        loadMoreCount++;
        transactionsListing();
    }
}

function returnDate(millis) {
    var date = new Date(parseInt(millis));
    date = date.toDateString();
    date = date.slice(4);
    return date;
}

var headerTitles = {
    criteria: 'Ways to earn', // no I18N
    reward: 'Ways to redeem', // no I18N
    reviews: 'Ways to review', // no I18N
    activity: 'Ways to earn' // no I18N
}

function createWhiteBox(data) {
    var boxContainer = createEle('div', 'widget-section'); // no I18N
    if (getData.signed_up_user && data.key === 'vip') {
        var currentTierDetails = tierCalculation();
        var currentTierContainer = createEle('div', 'current-tier-container'); // no I18N
        var currentTierName = createEle('h3'); // no I18N
        currentTierName.addEventListener('click', openSection.bind(null, 'vip-' + currentTierDetails.tierArrayPos, ''));
        currentTierName.innerHTML = currentTierDetails.currentTier;
        var pointsToMoveNextTier = createEle('p'); // no I18N
        if (currentTierDetails.tierPercentage === 100) {
            pointsToMoveNextTier.innerHTML = "Hooray! You've made it to the highest tier!"; // no I18N
        } else {
            pointsToMoveNextTier.innerHTML = getData.vip_program_details.tier_settings.tier_value_based_on === 'purchase_value' // no I18N
                ?
                'You are ' + getData.store_currency.symbol + currentTierDetails.valueForNextTier + ' away from reaching ' + currentTierDetails.nextTier // no I18N
                :
                'You are ' + currentTierDetails.valueForNextTier + ' points away from reaching ' + currentTierDetails.nextTier; // no I18N
        }
        var percentageLine = createEle('div', 'tier-percentage-line'); // no I18N
        var completedPercentage = createEle('span', 'completed-percentage-line'); // no I18N
        completedPercentage.style.width = currentTierDetails.tierPercentage + '%'; // no I18N
        completedPercentage.style.background = getData.page_preference_details.theme_color;
        percentageLine.append(completedPercentage);
        currentTierContainer.append(currentTierName, pointsToMoveNextTier, percentageLine);
        boxContainer.append(currentTierContainer);
    } else {
        var title = createEle('h2'); // no I18N
        title.innerHTML = data.title;
        boxContainer.append(title);
    }
    var boxDescription = createEle('p'); // no I18N
    var tabsContainer = createEle('div', 'tr-tabs-container'); // no I18N
    tabsContainer.classList.add(data.key);
    boxDescription.innerHTML = data.description;
    var tabsUl = createEle('ul'); // no I18N
    for (var tab = 0; tab < data.tabs.length; tab++) {
        var tabItem = createEle('li'); // no I18N
        var tabKey = data.key === 'vip' ? 'vip-' + tab : data.key; // no I18N
        tabItem.setAttribute('tr-item', tabKey); // no I18N
        tabItem.addEventListener('click', openSection.bind(null, tabKey, ''));
        if (data.key === 'vip') {
            var tierSpan = createEle('span'); // no I18N
            tierSpan.innerHTML = data.tabs[tab].tier_name;
            tabItem.append(tierSpan);
            if (getData.signed_up_user && currentTierDetails.currentTier === data.tabs[tab].tier_name) {
                tabItem.style.background = getData.page_preference_details.theme_color + '30';
            }
            if (tab == 0) {
                tabItem.innerHTML += 'You begin here'; // no I18N 
            } else {
                tabItem.innerHTML += getData.vip_program_details.tier_settings.tier_value_based_on === 'purchase_value' // no I18N
                    ?
                    'Spend ' + getData.store_currency.symbol + data.tabs[tab].tier_value_to_enter :
                    'Earn ' + data.tabs[tab].tier_value_to_enter + ' points'; // no I18N 
            }
        } else {
            tabItem.innerHTML = data.tabs[0];
        }
        tabsUl.append(tabItem);
    }
    tabsContainer.append(tabsUl);
    boxContainer.append(boxDescription, tabsContainer);
    return boxContainer;
}

function tierCalculation(data) {
    var val = getData.vip_program_details.tier_settings.tier_value_based_on === 'purchase_value' ? getData.total_purchase_val : getData.points_details.total_points; // no I18N
    var allTiers = getData.vip_program_details.tier_levels_data;
    var currentTierDetails = {
        currentTier: '',
        tierPercentage: '',
        valueForNextTier: '',
        nextTier: '',
        tierArrayPos: ''
    }
    for (var tier = 0; tier < allTiers.length; tier++) {
        if (val < allTiers[tier].tier_value_to_enter) {
            if (val < 0) {
                currentTierDetails.currentTier = allTiers[tier].tier_name;
                currentTierDetails.tierPercentage = 0;
                currentTierDetails.valueForNextTier = allTiers[tier + 1].tier_value_to_enter - (val);
                currentTierDetails.nextTier = allTiers[tier + 1].tier_name;
                currentTierDetails.tierArrayPos = tier;
            } else {
                currentTierDetails.currentTier = allTiers[tier - 1].tier_name;
                currentTierDetails.tierPercentage = val * 100 / allTiers[tier].tier_value_to_enter;
                currentTierDetails.valueForNextTier = allTiers[tier].tier_value_to_enter - val;
                currentTierDetails.nextTier = allTiers[tier].tier_name;
                currentTierDetails.tierArrayPos = tier - 1;
            }
            break;
        } else {
            currentTierDetails.currentTier = allTiers[allTiers.length - 1].tier_name;
            currentTierDetails.tierPercentage = 100;
            currentTierDetails.valueForNextTier = 0;
            currentTierDetails.tierArrayPos = allTiers.length - 1;
        }
    }
    return currentTierDetails;
}

var reviewTasks = ['capterra_review_activity', 'getapp_review_activity', 'producthunt_review_activity', 'trustpilot_review_activity', 'google_review_activity']; // no I18N

var reviewBrandNames = {
    capterra_review_activity: 'Capterra', // no I18N
    getapp_review_activity: 'GetApp', // no I18N
    trustpilot_review_activity: 'Trustpilot', // no I18N
    producthunt_review_activity: 'ProductHunt', // no I18N
    nps_activity: 'Net Promoter Score', // no I18N
    testimonial_activity: 'Customer Testimonial', // no I18N
    google_review_activity: 'Google' // no I18N
}


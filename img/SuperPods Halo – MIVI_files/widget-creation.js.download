var mailformat = /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/; // NO I18N

// Create SDK method
if (!byId('thrive_sdk_tag')) {
    var connectionTag = document.createElement('script');
    firstScriptTag = document.getElementsByTagName('script')[0];
    connectionTag.src = 'js/thrivesdk.js';
    connectionTag.id = "thrive_sdk_tag";
    firstScriptTag.parentNode.insertBefore(connectionTag, firstScriptTag);
}

// Recieve message from parent page 
window.addEventListener("message", recieveMessage, false);
async function recieveMessage(event) {
    if (event.data.messageType === 'zoho_commerce_CurrentPortalUser') {
        identifyZohoCommerce(event.data);
    } else if (event.data.messageType === 'wix_commerce_CurrentPortalUser') {
        identifyWixCommerce(event.data);
    } else if (event.data.messageType === 'trainer_central_CurrentPortalUser') {
        identifyTrainerCentral(event.data);
    } else if (event.data.messageType === 'custom_user_site_CurrentPortalUser') {
        identifyCustomUserSite(event.data);
    } else if (event.data.messageType === 'delete_Thrive_Cookie') {
        deleteRefCookieInLocalStorage(event.data.widget_code);
    } else if (event.data.reloadWidget) {
        reloadWidget(event.data.userDetails);
    } else if (event.data.type === 'ZTcookieConsent') {
        parentDomain = event.data.domain;
        var cookieConsent = await ecommerceServer.getCookieConsentSetting(event.data.thrivewidgetcode);
        userConsent = false;
        if (cookieConsent.code == 200) {
            userConsent = cookieConsent.data.status === 'disable' ? false : true; // NO I18N
            if (cookieConsent.data.privacy_policy_link) {
                privacyHTML(cookieConsent.data.privacy_policy_link)
            }
        }
        var data = {
            type: "ZTCookieConsentResponse", // NO I18N
            consentMessage: cookieConsent.data.ban_details,
            privacyLink: cookieConsent.data.privacy_policy_link,
            cookieConsent: userConsent
        }
        if (cookieConsent.data.privacy_policy_link) {
            data.privacyHTML = privacyElement.outerHTML
        }
        postMessageToParent(data);
    } else if (event.data.thrivewidgetcode) {
        zt_parent_domain = event.currentTarget.location.origin + '/';
        thriveWidgetCode = event.data.thrivewidgetcode;
        parentDomain = event.data.domain;
        platformType = event.data.thrive_platform;
        hideThriveWidget = event.data.hideWidget;
        campaignPathname = event.data.pathname;
        if (event.data.cookieConsent !== null && event.data.cookieConsent !== undefined) {
            setConsentCookieInLocalStorage(event.data.cookieConsent);
            ZTsetRefID();
        }
        if (event.data.thrive_platform === 'shopify') {
            if (!event.data.customer_data || event.data.customer_data.email == undefined) {
                commerceLoginRequired = true;
            } else if (event.data.customer_data != undefined && event.data.customer_data.email != undefined) {
                customerData = event.data.customer_data;
            }
            if (event.data.customer_data.signUpPage != undefined && event.data.customer_data.signInPage != undefined) {
                commerceSignupUrl = event.data.customer_data.signUpPage;
                commerceSignInUrl = event.data.customer_data.signInPage;
            }
            getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, customerData)).data;
            if (getData && ('program_mapped_user' in getData) && getData.program_mapped_user) {
                deleteRefCookieInLocalStorage(thriveWidgetCode);
                postMessageToParent('deleteParentThriveCookie'); // NO I18N
            }
            initiatePage();
        } else if (event.data.thrive_platform === 'zoho_commerce') {
            // processZohoCommerce();
            postMessageToParent('callZohoCommerceCurrentPortalUser'); // NO I18N
        } else if (event.data.thrive_platform === 'custom_user_site') {
            // processCustomUserSite();
            postMessageToParent('callCustomUserSitePortalUser'); // NO I18N
        } else if (event.data.thrive_platform === 'wix_commerce') {
            postMessageToParent('callWixSitePortalUser'); // NO I18N
        } else if (event.data.thrive_platform === 'trainer_central') {
            postMessageToParent('callTrainerCentralPortalUser'); // NO I18N
        }
    }
}

async function reloadWidget (sendData) {
    document.body.classList.add('widget-loading'); // NO I18N
	document.querySelectorAll(".widget-container").forEach(el => el.remove()); // NO I18N
	getData.member_auth_token = '';
    getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, sendData)).data;
    document.body.classList.remove('widget-loading'); // NO I18N
    commerceLoginRequired = (getData && getData.signed_up_user) ? !getData.signed_up_user : true;
    initiatePage();
}

document.body.classList.add('widget-loading'); // no I18N

var shareurl;
var getData;
// Get Page Content
async function getContent() {
    getData = (await thrivePublicServer.identifyMember(thriveWidgetCode, customerData)).data;
    if (getData && ('program_mapped_user' in getData) && getData.program_mapped_user) {
        deleteRefCookieInLocalStorage(thriveWidgetCode);
        postMessageToParent('deleteParentThriveCookie'); // NO I18N
    }
    initiatePage();
}

// CREATING HTML ELEMENTS
function createEle(ele, cls, id) {
    var element = document.createElement(ele);
    cls ? element.className += cls : '' // Add class
    id ? element.setAttribute("id", id) : '' // Add id
    return element;
}


async function redeemConfirmationPop() {
    if (redeemID) {
        document.getElementsByClassName('redeem-confirm')[0].innerHTML = 'Redeeming..' // NO I18N
        var redeemResponse = await loyaltyServer.redeemReward(thriveWidgetCode, redeemID);
        if (redeemResponse.status && redeemResponse.status === 412) {
            redeemCompleted('contact_admin'); // no I18N 
        } else if (redeemResponse.data && redeemResponse.data.error_code && redeemResponse.data.error_code === 3140) {
            redeemCompleted('contact_admin'); // no I18N 
        } else if (redeemResponse.data && redeemResponse.data.code && redeemResponse.data.code === 200) {
            redeemCompleted(redeemResponse.data.reward_status);
            updatePoints = true;
            getContent();
        } else {
            showAnnouncement('There is some error', 'error'); // no I18N 
        }
    }
}

function redeemCompleted(statuss) {
    var redeemText = {
        approve: {
            head: "Redeemed", // no I18N 
            description: "Reward redeemed successfully.\n You will receive an email with reward details" // no I18N
        },
        approval_pending: {
            head: "Pending for approval", // no I18N 
            description: "Request for reward redemption is processed. Once admin approves, you will receive an email with reward details" // no I18N
        },
        failed: {
            head: "Failed", // no I18N
            description: "Oops, unable to process the reward. Kindly contact the admin" // no I18N
        },
        contact_admin: {
            head: "Uh-oh!", // no I18N
            description: "There is an issue with redeeming this reward. Please contact the site owner." // no I18N
        }
    }
    var statusIcon = document.createElement('div');
    statusIcon.setAttribute('redeem-status', statuss);
    statusIcon.setAttribute('class', 'redeem-status-icon');
    document.getElementsByClassName('pop-container')[0].prepend(statusIcon)
    document.getElementsByClassName('popup-head')[0].innerHTML = redeemText[statuss].head;
    document.getElementsByClassName('redeem-desc')[0].innerHTML = redeemText[statuss].description;
    document.getElementsByClassName('redeem-confirm')[0].innerHTML = 'Close' // NO I18N
    document.getElementsByClassName('redeem-confirm')[0].classList.remove('lp-primary-btn'); // NO I18N
    document.getElementsByClassName('redeem-confirm')[0].classList.add('lp-secondary-btn'); // NO I18N
    document.getElementsByClassName('redeem-confirm')[0].removeEventListener('click', redeemConfirmationPop); // NO I18N
    document.getElementsByClassName('redeem-confirm')[0].addEventListener('click', closeRedeemPop); // NO I18N
}

function closeRedeemPop() {
    document.getElementsByClassName('pop-overlay')[0].remove();
}

function simpleSocialShare(medium) {
    var message = getData.page_preference_details.user_invite_message !== undefined ? getData.page_preference_details.user_invite_message : 'Join'; // NO I18N
    var shareUrl;        
    if (medium === 'facebook') {
        shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + shareurl + '&quote=' + message; // NO I18N
    } else if (medium === 'linkedin') { // NO I18N
        shareUrl = 'https://www.linkedin.com/shareArticle?mini=true&url=' + shareurl + '&title=' + message; // NO I18N
    } else if (medium === 'twitter') { // NO I18N
        shareUrl = 'https://twitter.com/intent/tweet?text=' + message + '%0d%0a' + shareurl; // NO I18N
    } else if (medium === 'whatsapp') {
        shareUrl = 'https://api.whatsapp.com/send?phone=&text=' + message + '%0d%0a' + shareurl; // NO I18N
    } if (medium === 'copy') { // NO I18N
        copyUrl();
    }
    shareUrl ? openNewWindow(shareUrl) : false;
}


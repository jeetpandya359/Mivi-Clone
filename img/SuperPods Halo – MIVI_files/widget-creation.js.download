// Earn Points
var postData, medium, criteriaID;
async function completeTask() {
    var taskName = event.target.getAttribute('task-name');
    medium = event.target.getAttribute('task-medium');
    criteriaID = event.target.getAttribute('task-id');
    var widgetCodeFB = thriveWidgetCode;
    if (taskName === 'friend_purchase' || taskName === 'refer_a_friend') {
        var scrollHeight = byId('zgiquicontent').offsetTop; // NO I18N
        window.scrollTo({
            top: scrollHeight,
            behavior: 'smooth' // NO I18N
        });
        setTimeout(function() {
            document.getElementsByClassName('referral-navigation-text')[0].classList.add('show') // no I18N
        }, 300);
        setTimeout(function() {
            document.getElementsByClassName('referral-navigation-text')[0].classList.remove('show') // no I18N
        }, 3000);
    } else if (taskName === "share_facebook") {
        postData = await httpRequest('GET', 'publicapi/' + thriveWidgetCode + '/social/' + criteriaID + '/' + medium); // no I18N
        openNewWindow('https://www.facebook.com/sharer/sharer.php?u=' + postData.user_share_url + '&quote=' + postData.social_medium_message); // NO I18N
        postingSuccess(postData, medium, criteriaID, widgetCodeFB);
        if (getData.purchase_url && getData.purchase_url !== null) {
            openNewWindow(getData.purchase_url);
        }
    }
}

function showSignupResponse(message) {
    document.getElementsByClassName('page-container')[0].innerHTML = '<div class="signup-response-message">' + message + '</div>';
}

async function postingSuccess(data, medium, criteriaID, widgetCodeFB) {
    var secretKey = data.social_secret_key;
    if (checkIfFollowMedium(medium)) {
        await loyaltyServer.postSocialFollowTaskSuccess(widgetCodeFB, criteriaID, medium, secretKey);
    } else {
        await loyaltyServer.postSocialTaskSuccess(widgetCodeFB, criteriaID, medium, secretKey);
    }
    showAnnouncement(taskCompletitonMessages(medium), 'success'); // no I18N
    updatePoints = true;
    getContent();
}

function taskCompletitonMessages(medium) {
    var message = 'Successfully shared'; // NO I18N
    if (medium === 'follow_instagram' || medium === 'follow_linkedin' || medium === 'follow_twitter') {
        message = 'Successfully followed'; // NO I18N
    } else if (medium === 'like_facebook') {
        message = 'Successfully liked'; // NO I18N
    } else if (medium === 'youtube_subscribe') {
        message = 'Successfully subscribed'; // NO I18N
    }
    return message;
}

function addFieldError(referenceNode, errorMessage) {
    var fieldID = referenceNode.getAttribute('id');
    var errorText = document.createElement("span")
    errorText.setAttribute('class', 'field-error-msg')
    errorText.setAttribute('error-for', fieldID)
    errorText.innerHTML = errorMessage !== undefined ? errorMessage : "Field should not be empty" // No I18N
    referenceNode.parentNode.insertBefore(errorText, referenceNode.nextSibling);
}

function removeFieldError() {
    var errors = document.querySelectorAll('.field-error-msg') // No I18N
    for (var field = 0; field < errors.length; field++) {
        errors[field].remove()
    }
}

function copyToClipboard(data) {
    if (data) {
        var aux = document.createElement("input");
        aux.setAttribute("value", data);
        byId('widgetContainer').appendChild(aux); // NO I18N
        aux.select();
        document.execCommand("copy"); // NO I18N
        byId('widgetContainer').removeChild(aux); // NO I18N
    }
    return false;
}

function checkIfFollowMedium(medium) {
    var mediumList = ['youtube_subscribe', 'follow_twitter', 'follow_instagram', 'like_facebook', 'follow_linkedin', 'refer_a_survey']; // no I18N
    if (mediumList.includes(medium)) {
        return true;
    }
    return false;
}


function reviewsListing(data) {
    var allTasks = createEle('div', 'all-tasks-box'); // no I18N
    var objKeys = Object.keys(data.review_criterias);
    var completedReviews = createEle('div', 'completed-todo-box'); // no I18N
    var completedHeading = createEle('h4'); // no I18N
    completedHeading.innerHTML = 'Completed reviews'; // no I18N
    completedReviews.append(completedHeading);
    var completedTaskList = false;
    for (var i = 0; i < objKeys.length; i++) {
        var item = data.review_criterias[objKeys[i]];
        var taskKey = Object.keys(item.user_criterias_detail.criterias)[0];
        var rewardKey = Object.keys(item.user_rewards_detail.rewards)[0];
        var reviewBox = createEle('div', 'todo-box'); // no I18N
        reviewBox.setAttribute('box-item', i);
        var rewardName = createEle('h4', 'reward-head'); // no I18N
        rewardName.setAttribute('reward-type', rewardKey)
        var taskName = createEle('div', 'review-task'); // no I18N
        taskName.setAttribute('task-name', taskKey);
        rewardName.innerHTML = item.reward_config_name;
        taskName.innerHTML = reviewTasks.indexOf(taskKey) > -1 ? 'Review on ' + reviewBrandNames[taskKey] : reviewBrandNames[taskKey];
        if (getData.signed_up_user) {
            if (data.members_criteria_reward_json[objKeys[i]].criterias[taskKey].status === 'not_completed') {
                taskName.addEventListener('click', initiateReviewTask.bind(null, i, taskKey, item, data.page_preference_details.theme_color, ''));
            }
            if (data.members_criteria_reward_json[objKeys[i]].criterias[taskKey].status === 'admin_approval') {
                reviewBox.setAttribute('review-completed', true);
                var approvalInfo = createEle('div', 'review-pending-info'); // no I18N
                approvalInfo.innerHTML = 'Pending for approval'; // no I18N
                reviewBox.append(approvalInfo);
            }
        }
        reviewBox.prepend(rewardName, taskName)
        if (data.members_criteria_reward_json[objKeys[i]].criterias && (data.members_criteria_reward_json[objKeys[i]].criterias[taskKey].status === 'completed' || data.members_criteria_reward_json[objKeys[i]].criterias[taskKey].status === 'admin_approval')) {
            completedTaskList = true;
            completedReviews.append(reviewBox);
        } else {
            allTasks.append(reviewBox);
        }
    }
    var popHeader = createEle('div', 'pop-header'); // no I18N
    var reviewsHeader = createEle('h3'); // no I18N
    reviewsHeader.innerHTML = 'Review and earn'; // no I18N
    popHeader.append(reviewsHeader);
    var overlay = createEle('div', 'pop-overlay'); // no I18N
    document.getElementsByClassName('tr-wrapper')[0].append(closeButtonCreate(), popHeader, allTasks, overlay);
    if (completedTaskList) {
        document.getElementsByClassName('tr-wrapper')[0].append(completedReviews);
    }
}


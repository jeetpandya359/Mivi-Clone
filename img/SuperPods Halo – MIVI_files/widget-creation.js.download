    document.getElementsByClassName('pop-up-overlay')[0].classList.remove('active'); // NO I18N
    document.body.classList.remove('scrollDisable'); // NO I18N
}

// WEBVIEW CHANGES
function detectLoadingEngine() {
    var engine = 'Web Browser'; // NO I18N
    if (typeof navigator !== 'undefined') {
        var ua = navigator.userAgent || navigator.vendor || window.opera;
        if (/Android/i.test(ua)) {
            engine = /wv|Version\/.*Chrome\/.* Mobile/.test(ua) ? 'Android WebView' : 'Android Browser'; // NO I18N
        } else if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
            engine = /CriOS/.test(ua) ? 'iOS Chrome' : /Safari/.test(ua) ? 'iOS Safari' : 'iOS WebView'; // NO I18N
        }
    } else {
        engine = 'Unknown Environment'; // NO I18N
    }
    return engine;
}


var loadingEngine = detectLoadingEngine();

function openLinkFromParent (url) {
    var data = {
        message: 'openLink', // NO I18N
        url: url
    }
    postMessageToParent(data);
}

function openNewWindow (url) {
    if (loadingEngine === 'Web Browser') {
        window.open(url, '_blank'); // NO I18N
    } else {
        openLinkFromParent(url);
    }
}
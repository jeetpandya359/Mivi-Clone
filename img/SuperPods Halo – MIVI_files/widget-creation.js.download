            thrivePublicServer.identifyMember(thriveWidgetCode, JSON.stringify(customerData));
        } else if (optinResponse.data.error_code === 100060) {
            changeSignupContent('approval-pending'); // NO I18N
        } else if (optinResponse.data.error_code === 100240) {
            changeSignupContent('singup-done-check-mail'); // NO I18N
        }
    }
}


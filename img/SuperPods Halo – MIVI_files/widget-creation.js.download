function initiateReviewTask(listing, task, data, themeColor) {
    selectedReviewBox = listing
    var secondaryModalCloseBtn = createEle('div', 'secondary-modal-close'); // no I18N
    secondaryModalCloseBtn.addEventListener('click', secondaryModalClose);
    var taskInputsContainer = createEle('div', 'task-inputs-container'); // no I18N
    taskInputsContainer.setAttribute('selected-task', task);
    taskInputsContainer.append(secondaryModalCloseBtn);
    taskDetail.selected_task = task; // Selected task
    taskDetail.criteria_config_id = data.criteria_config_id; // Criteria config id
    // HEADER
    var modalTaskHeader = createEle('h3', 'modal-task-head'); // no I18N
    modalTaskHeader.innerHTML = reviewTasks.indexOf(task) > -1 ? 'Review on ' + reviewBrandNames[task] : reviewBrandNames[task];
    // SUBMIT BUTTON
    var submitBtn = createEle('div', 'btn-style primary-btn mT20'); // no I18N
    submitBtn.setAttribute('id', 'task-submit-btn');
    submitBtn.innerHTML = 'Submit'; // no I18N
    submitBtn.style.background = themeColor;
    if (task === 'nps_activity') {
        var modalTaskQuest = createEle('p', 'modal-task-quest'); // no I18N
        modalTaskQuest.innerHTML = data.user_criterias_detail.criterias[task].question;
        var npsNumbers = createEle('ul', 'clearfix nps-numbers-ul'); // no I18N
        for (var number = 1; number < 11; number++) {
            var numberEle = createEle('li', 'nps-number-item'); // no I18N
            numberEle.setAttribute('nps-number', number);
            numberEle.setAttribute('id', 'review-value');
            numberEle.innerHTML = number;
            numberEle.addEventListener('click', npsRatingClick.bind(null, numberEle, ''));
            npsNumbers.append(numberEle);
        }
        submitBtn.classList.add('inactive'); // no I18N
        taskInputsContainer.append(modalTaskHeader, modalTaskQuest, npsNumbers, submitBtn);
    } else if (task === 'testimonial_activity') {
        var testimonialQuestion = createEle('h4'); // no I18N
        testimonialQuestion.innerHTML = data.user_criterias_detail.criterias[task].question;
        var testimonialInput = createEle('textarea', 'input-style'); // no I18N
        testimonialInput.setAttribute('id', 'review-value');
        testimonialInput.setAttribute('placeholder', 'Type something');
        submitBtn.addEventListener('click', completeReviewTask);
        taskInputsContainer.append(modalTaskHeader, testimonialQuestion, testimonialInput, submitBtn);
    } else {
        var freshReviewContainer = createEle('div', 'go-review-container clearfix'); // no I18N
        var goReviewBtn = createEle('div', 'btn-style'); // no I18N
        goReviewBtn.addEventListener('click', function() {
            openNewWindow(data.user_criterias_detail.criterias[task].site_url)
        });
        goReviewBtn.innerHTML = 'Click to Review'; // no I18N
        goReviewBtn.style.background = getData.page_preference_details.theme_color;
        var copyBtn = createEle('div', 'review-url-copy'); // no I18N
        copyBtn.innerHTML = 'Copied!'; // no I18N
        copyBtn.addEventListener('click', function(event) {
            //var copyResponse = copyToClipboard.bind(null, data.user_criterias_detail.criterias[task].site_url, '');
            copyToClipboard(data.user_criterias_detail.criterias[task].site_url);
            copyBtn.classList.add('copied'); // no I18N
        }, false);
        var clearFix = createEle('div', 'clearfix'); // no I18N
        clearFix.append(goReviewBtn, copyBtn);
        var taskNote = createEle('div', 'task-note mT10'); // no I18N
        taskNote.innerHTML = 'After submitting your review to the site, you will receive a confirmation link upon successful approval. Paste it in the field below to complete the task.'; // no I18N
        freshReviewContainer.append(clearFix, taskNote);
        // Already reviewed
        var alreadyReviewdContainer = createEle('div', 'review-already-container'); // no I18N
        var reviewedHead = createEle('h4'); // no I18N
        reviewedHead.innerHTML = 'Have you reviewed already?'; // no I18N
        var urlInput = createEle('input', 'input-style'); // no I18N
        urlInput.setAttribute('id', 'review-value');
        urlInput.setAttribute('placeholder', 'Enter url');
        submitBtn.addEventListener('click', completeReviewTask);
        alreadyReviewdContainer.append(reviewedHead, urlInput, submitBtn);
        taskInputsContainer.append(modalTaskHeader, freshReviewContainer, alreadyReviewdContainer, submitBtn);
    }
    document.getElementsByClassName('pop-overlay')[0].classList.add('active'); // no I18N
    document.getElementsByClassName('pop-overlay')[0].append(taskInputsContainer);
}

function secondaryModalClose() {
    document.getElementsByClassName('pop-overlay')[0].classList.remove('active'); // no I18N
    document.getElementsByClassName('pop-overlay')[0].innerHTML = ''; // no I18N
}

function npsRatingClick(ele) {
    var number = ele.getAttribute('nps-number');
    var allItems = document.getElementsByClassName('nps-number-item'); // no I18N
    for (var item = 0; item < allItems.length; item++) {
        allItems[item].removeAttribute('rated-item');
    }
    ele.setAttribute('rated-item', true);
    taskDetail.input_value = number; // Input value
    taskDetail.input_value = number; // Input value
    var submitBtn = byId('task-submit-btn'); // no I18N
    submitBtn.classList.remove('inactive'); // no I18N
    submitBtn.addEventListener('click', completeReviewTask);
}

async function completeReviewTask() {
    var taskBasedParam, sendData;
    var reviewRegex = /^(http(s)?:\/\/)[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-z]{2,6}\b([-a-zA-Z0-9@:%_\+.~#?&//=]*)$/
    removeFieldError()
    var isValid = true;
    if (!byId('review-value').value && taskDetail.selected_task !== 'nps_activity') {
        byId('review-value').classList.add('error'); // no I18N
    } else {
        if (taskDetail.selected_task !== 'testimonial_activity' && !reviewRegex.test(byId('review-value').value)) {
            byId('review-value').classList.add('error'); // no I18N
            addFieldError(byId('review-value'), 'Please enter a valid url'); // no I18N
            isValid = false;
        } else if (taskDetail.selected_task === 'nps_activity') {
            sendData = {
                'rating': taskDetail.input_value // no I18N
            };
            taskBasedParam = 'nps'; // no I18N
        } else if (taskDetail.selected_task === 'testimonial_activity') {
            sendData = {
                'testimonial': byId('review-value').value // no I18N
            };
            taskBasedParam = 'testimonial'; // no I18N
        } else {
            sendData = {
                'site_url': byId('review-value').value // no I18N
            };
            taskBasedParam = 'review'; // no I18N
        }
        if (isValid) {
            byId('task-submit-btn').classList.add('btn-loading'); // no I18N
            var resp = await httpRequest('POST', 'widget/' + thriveWidgetCode + '/reviewtask/' + taskBasedParam + '/' + taskDetail.criteria_config_id, JSON.stringify(sendData), true); // no I18N
            byId('task-submit-btn').classList.remove('btn-loading'); // no I18N
            if (resp.status === 200) {
                secondaryModalClose()
                updateReviews = true;
                getContent();
            } else if (resp.status === 412) {
                addFieldError(byId('review-value'), 'Please enter a valid url'); // no I18N
                //showAnnouncement('Please provide a valid URL', 'error');
            }
        }
    }
}

function moveFinishedReview() {
    var finishedTask = document.querySelector('[box-item="' + selectedReviewBox + '"]').cloneNode(true); // no I18N
    document.querySelector('[box-item="' + selectedReviewBox + '"]').remove(); // no I18N
    finishedTask.removeEventListener('click', initiateReviewTask);
}


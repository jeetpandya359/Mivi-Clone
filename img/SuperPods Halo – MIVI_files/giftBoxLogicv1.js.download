    collectionPage:{
        init: async function (settings) {
            gbbExt.utility.debugConsole("collectionPage-init")
            gbbExt.collectionPage.initialize();
            // gbbExt.gbbExtLinkToBundlePage.init(settings, "COLLECTION_PAGE")
            // gbbExt.gbbExtBundleUpsell.init(settings, "COLLECTION_PAGE")
        },
        initialize: function () {
            // get all the bundle links re

            gbbExt.collectionPage.f.overWriteDummyProductLinksWithBundleLink()
                
            

        },
        f:{
            overWriteDummyProductLinksWithBundleLink: function(){
                try{
                    // Check if the function has already been called
                    if (!gbbExt.settings.app.overWriteDummyProductsLinkOnCollectionPages){
                        return;
                    }

                    let bundleLinkProductHandleMap = gbbExt.settings.bundleLinkProductHandleMap;
                    let allBundleHandles = [];

                    bundleLinkProductHandleMap.forEach(function(value, key) {
                        allBundleHandles.push(key);
                    });

                    // gbbExt.utility.debugConsole(allBundleHandles);

                    for (let i = 0; i < allBundleHandles.length; i++) {
                        let handle = allBundleHandles[i];
                        let domelements = gbbExt.$("a").filter(function() {
                            let href = gbbExt.$(this).attr("href");
                            return href && href.includes(handle);
                        });

                        domelements.each(function(index, element) {
                            let href = gbbExt.$(element).attr("href");
                            if (href && href.includes("/apps/")) {
                                // Skip elements with href containing /apps/
                                return;
                            }

                            gbbExt.utility.debugConsole("overwriting now for handle: " + handle);

                            let productHandle = handle;
                            let bundleId = bundleLinkProductHandleMap.get(productHandle).bundleId;

                            // Get BundleUrl
                            let bundleUrl = gbbExt.gbbExtLinkToBundlePage.f.getBundleUrl(bundleId);

                            // Replace all the href attributes of the elements with the bundleUrl
                            gbbExt.$(element).attr("href", bundleUrl);

                            // Also replace any elements that have buttons
                            let button = gbbExt.$(element).find("button");
                            if (button.length > 0) {
                                // Prevent default on onclicks
                                gbbExt.$(button).on('click', function(event) {
                                    event.preventDefault();
                                    event.stopPropagation();
                                    window.location.href = bundleUrl;
                                });
                            }

                            // Also replace any buttons in the parent
                            let parentButton = gbbExt.$(element).parent().find("button");
                            if (parentButton.length > 0) {
                                // Prevent default on onclicks
                                gbbExt.$(parentButton).on('click', function(event) {
                                    event.preventDefault();
                                    event.stopPropagation();
                                    window.location.href = bundleUrl;
                                });
                            }
                        });
                    }

                        
                }catch(err){
                    // debugConsole.
                    gbbExt.utility.debugConsole("err in overWriteDummyProductLinksWithBundleLink",err)  
                }
            },
            
        }

    },
    cartPageExtModal: {
        init: function(boxId){
            gbbExt.cartPageExtModal.initialize.renderRemoveCartItemConformationModal(boxId);
        },
        initialize:{
            renderRemoveCartItemConformationModal: function(boxId) {
                try {
                    const gbbRemoveCartItemConfirmationMainContainer = gbbExt.$("<div>").addClass("gbbRemoveCartItemConfirmationMainContainer");
                    const gbbRemoveCartItemConfirmationContainerModal = gbbExt.$("<div>").addClass("gbbRemoveCartItemConfirmationContainerModal");
            
                    const gbbCartPageCartProductsContainerHeader = gbbExt.$("<div>").addClass("gbbCartPageCartProductsContainerHeader");
                    const gbbCartPageCartProductsContainerHeaderLabel = gbbExt.$("<div>").addClass("gbbCartPageCartProductsContainerHeaderLabel")
                    .text(gbbExt?.settings?.languageData?.general?.removeAllBoxProducts?.value || "This is a Box Product. Removing this will remove all the products from box")
                    .append(" ").append(boxId).append(".")
                    const gbbCartPageCartProductsContainerBody = gbbExt.$("<div>").addClass("gbbCartPageCartProductsContainerBody");
                
                    const gbbCartPageCartModalProductsContainer = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductsContainer");

                    const gbbCartPageProductsModalFooter = gbbExt.$("<div>").addClass("gbbCartPageProductsModalFooter");
                    
                    const gbbCartPageProductsModalFooterBackBtn = gbbExt.$("<div>").addClass("gbbCartPageProductsModalFooterBackBtn");
                    gbbCartPageProductsModalFooterBackBtn.text(gbbExt?.settings?.languageData?.general?.backButtonText?.value||"Back");
                    gbbCartPageProductsModalFooterBackBtn.css("background", gbbExt?.settings?.pageCustomizationData?.cartFooter?.cartFooterBackButtonColor || "#6d7175");
                    gbbCartPageProductsModalFooterBackBtn.css("color", gbbExt?.settings?.pageCustomizationData?.cartFooter?.cartFooterBackButtonTextColor || "#ffffff");
                    gbbCartPageProductsModalFooterBackBtn.on("click", async ()=>{
                        gbbCartPageProductsModalFooterBackBtn.addClass("gbbDisabled")
                        gbbCartPageProductsModalFooterRemoveBtn.addClass("gbbDisabled")
                        gbbCartPageProductsModalFooterBackBtn.removeClass("gbbDisabled")
                        gbbCartPageProductsModalFooterRemoveBtn.removeClass("gbbDisabled")
                        gbbExt.$("body").find(".gbbRemoveCartItemConfirmationMainContainer").remove()
                    })

                    const gbbCartPageProductsModalFooterRemoveBtn = gbbExt.$("<div>").addClass("gbbCartPageProductsModalFooterRemoveBtn");
                    gbbCartPageProductsModalFooterRemoveBtn.text(gbbExt.settings?.languageData?.general?.removeButtonText?.value ||"Remove")
                    gbbCartPageProductsModalFooterRemoveBtn.css("background", gbbExt?.settings?.pageCustomizationData?.summaryBlock?.summaryBlockAddToCartButtonColor || "#000000")
                    gbbCartPageProductsModalFooterRemoveBtn.css("color", gbbExt?.settings?.pageCustomizationData?.summaryBlock?.summaryBlockAddToCartButtonTextColor || "#ffffff")
                    gbbCartPageProductsModalFooterRemoveBtn.on("click", async (event)=>{
                        event.preventDefault();
                        event.stopPropagation();
                        gbbCartPageProductsModalFooterBackBtn.addClass("gbbDisabled")
                        gbbCartPageProductsModalFooterRemoveBtn.addClass("gbbDisabled")
                        let removeProducts = await gbbExt.utility.removeAllProductsFromRelevantBox(boxId);
                        if(removeProducts) {
                            // setTimeout(()=>{
                                gbbExt.$("body").find(".gbbRemoveCartItemConfirmationMainContainer").remove()
                                window.location.reload(true);
                            // },5000)
                        }
                        // gbbCartPageProductsModalFooterRemoveBtn.text(gbbExt.settings.languageData.general?.loadingCheckoutButtonText?.value || "Loading ...1")
                        // await gbb.utility.applyDiscountOnCheckout();
                        // gbb.gbbBrowser.clearCartDataFromSessionStorage();

                        // await gbb.utility.loadCheckoutPage();
                    })

                    gbbCartPageProductsModalFooter.append(gbbCartPageProductsModalFooterBackBtn);
                    gbbCartPageProductsModalFooter.append(gbbCartPageProductsModalFooterRemoveBtn);



                    let products = gbbExt.utility.getRelevantBoxProducts(boxId);
                    products.forEach((product) => {
                        const gbbCartPageCartModalProductContainer = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductContainer");
                        //attach a data attriute to the product container
                        gbbCartPageCartModalProductContainer.attr("productId", product?.product_id);
                        gbbCartPageCartModalProductContainer.attr("variantId", product?.variant_id)
                
                        const gbbCartPageCartProductImageContainer = gbbExt.$("<div>").addClass("gbbCartPageCartProductImageContainer");
                        const gbbCartPageCartModalProductImage = gbbExt.$("<img>").addClass("gbbCartPageCartModalProductImage");
                        gbbCartPageCartModalProductImage.attr("src", product.image);
                        const gbbCartPageCartModalProductTextContainer = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductTextContainer");
                        
                        const gbbCartPageCartModalProductTitleContainer = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductTitleContainer");
                        const gbbCartPageCartModalProductTitle = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductTitle");
                        const gbbCartPageCartModalProductQuantity = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductQuantity");
                        
                        const gbbCartPageCartModalProductPriceQtyContainer = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductPriceQtyContainer");
                        const gbbCartPageCartModalProductPrice = gbbExt.$("<div>").addClass("gbbCartPageCartModalProductPrice");
                        //a button to remove the product from the cart
                
                        gbbCartPageCartModalProductTitle.text(product.title);
                        gbbCartPageCartModalProductPrice.text(gbbExt.utility.formatPrice(product.price));
                        gbbCartPageCartModalProductQuantity.text("x" + product.quantity);
                        gbbCartPageCartProductImageContainer.append(gbbCartPageCartModalProductImage);
                
                        gbbCartPageCartModalProductTitleContainer.append(gbbCartPageCartModalProductTitle);
                        //gbbCartPageCartModalProductTitleContainer.append(gbbCartPageCartModalProductQuantity);
                
                        gbbCartPageCartModalProductTextContainer.append(gbbCartPageCartModalProductTitleContainer);
                        gbbCartPageCartModalProductPriceQtyContainer.append(gbbCartPageCartModalProductQuantity);
                        gbbCartPageCartModalProductPriceQtyContainer.append(gbbCartPageCartModalProductPrice);
                        gbbCartPageCartModalProductTextContainer.append(gbbCartPageCartModalProductPriceQtyContainer);
                
                        gbbCartPageCartModalProductContainer.append(gbbCartPageCartProductImageContainer);
                        gbbCartPageCartModalProductContainer.append(gbbCartPageCartModalProductTextContainer);
                        gbbCartPageCartModalProductsContainer.append(gbbCartPageCartModalProductContainer);
                    })
            
                    gbbCartPageCartProductsContainerHeader.append(gbbCartPageCartProductsContainerHeaderLabel);
            
                    gbbCartPageCartProductsContainerBody.append(gbbCartPageCartModalProductsContainer);
            
                    gbbRemoveCartItemConfirmationContainerModal.append(gbbCartPageCartProductsContainerHeader);
                    gbbRemoveCartItemConfirmationContainerModal.append(gbbCartPageCartProductsContainerBody);
                    gbbRemoveCartItemConfirmationContainerModal.append(gbbCartPageProductsModalFooter);
            
                    gbbRemoveCartItemConfirmationMainContainer.append(gbbRemoveCartItemConfirmationContainerModal);
                    gbbExt.$("body").append(gbbRemoveCartItemConfirmationMainContainer);
            
                } catch(err) {
                    gbbExt.utility.debugConsole(err);
                }
            }
        },
        f:{
            findInCartProductsByLineValue : function(cartData, line) {
                try {
                    // let allCartItems = await gbbExt.utility.getCart();
                    let allCartItems = cartData.items || [];
                    let item = allCartItems[parseInt(line)-1]
                    if(item && item?.properties) {
                        let properties = Object.keys(item.properties) || [];
                        if (properties.includes("Box ID")) {
                            return item;
                        }
                    }
                    return false;
                } catch(err) {
                    gbbExt.utility.debugConsole(err)
                }
            },
            findInCartProductsByKeyValue : function(cartData, key) {
                try {
                    // let allCartItems = await gbbExt.utility.getCart();
                    let allCartItems = cartData.items || [];
                    for(let i=0; i<allCartItems.length; i++) {
                        let item = allCartItems[i];
                        if(item && item?.properties){
                            let properties = Object.keys(item.properties) || [];
                            if(item.key == key && (properties.includes("Box ID"))) {
                                return item;
                            }
                        }
                    }
                    return false;
                } catch(err) {
                    gbbExt.utility.debugConsole(err)
                }
            },
            findInCartProductsByIndex : function (cartData,index) {
                try {
                    let allCartItems = cartData.items || [];
                                        let item = allCartItems[parseInt(index)]
                                        if(item && item?.properties) {
                                            let properties = Object.keys(item.properties) || [];
                                            if (properties.includes("Box ID")) {
                                                return item;
                                            }
                                        }
                    return false;
                } catch(err) {
                    gbbExt.utility.debugConsole("error inside findInCartProductsByIndex", err);
                }
            }
        }
    },
    gbbCartPageExt:{
        f:{
            overWriteCheckoutBtn: async function (elementSelector) {
              try {
                  let checkoutBtnEle = gbbExt.$(document).find(elementSelector)
                  let checkoutBtnParent =  checkoutBtnEle.parent();
                  if (checkoutBtnEle && checkoutBtnEle.length > 0 && gbbExt.$(checkoutBtnParent).find(".gbbExt-overwrite-checkout-btn").length == 0) {
                      checkoutBtnEle.show()
                      checkoutBtnEle.unbind().unbind("click").off().off("click");
                      let newcheckoutBtnEle = checkoutBtnEle.clone()
                    //   gbbExt.utility.debugConsole("newcheckoutBtnEle", newcheckoutBtnEle)
                      checkoutBtnEle.after(newcheckoutBtnEle)
                      checkoutBtnEle.hide()
                      newcheckoutBtnEle.addClass("gbbExt-overwrite-checkout-btn")
      
                      gbbExt.state.cartData = await gbbExt.utility.getCart();

                      newcheckoutBtnEle.on("click", function (event) {
                          event.preventDefault();
                          event.stopPropagation();
                          gbbExt.$(this).attr("disabled", true);
                          let loadingCheckoutText = gbbExt.utility.renderLanguageValue(gbbExt.settings.languageData.general.cartPageCheckoutButtonLoadingText);
                          newcheckoutBtnEle.text(loadingCheckoutText || "loading checkout...");
                          setTimeout(() => { gbbExt.$(this).attr("disabled", false) }, 3000)
                          addToCartBtnEle = gbbExt.$(document).find(gbbExt.selectors.addToCart)
                          sideCartEle = gbbExt.$(document).find(gbbExt.selectors.sideCartSelectors)
      
                          // gbbExt.$(document).find("body").addClass("loadingCheckoutPage")
                          // gbbExt.$(document).find("body").text("loading checkout...")
      
                          if (sideCartEle && sideCartEle.length > 0) {
                              sideCartEle.css("display", "none")
                          }
      
                          if (addToCartBtnEle && addToCartBtnEle.length > 0) {
                              addToCartBtnEle.trigger("click")
                          }
                          setTimeout(() => {
                              // let properties =  gbbExt.state.cartData.properties;
                              let discountString = gbbExt.utility.prepareDiscountStringFromCart();
                              if(discountString) {
                                  window.location.href = window.location.origin + "/cart/checkout?discount=" + discountString
                              }else{
                                  window.location.href = window.location.origin + "/cart/checkout"
                              }
                          }, 1000)
      
                      })
      
                  }else if(checkoutBtnEle.length < 1){
                    // gbbExt.utility.debugConsole("checkout-button not found")
                  }else{
                    // gbbExt.utility.debugConsole("checkout-button already overwritten")
                  }
              } catch (error) {
                gbbExt.utility.debugConsole("error inside overWriteCheckoutBtn", error);
                return false;
              }
            },
        }
    },
